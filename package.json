{
  "name": "athenode-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build-plugin.mjs",
    "update-cli": "node scripts/update-cli.mjs",
    "library:snapshot": "node scripts/library-snapshot.mjs",
    "library:publish": "node scripts/publish-library.mjs",
    "test": "node scripts/validate.mjs && node --test scripts/*.test.mjs && node scripts/build-plugin.mjs --check"
  },
  "devDependencies": {
    "@athenode/cli": "0.10.7",
    "yaml": "2.8.1"
  }
}
